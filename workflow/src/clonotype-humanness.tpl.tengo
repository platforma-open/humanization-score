self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
math := import("math")

humannessCalcSw := assets.importSoftware("@platforma-open/milaboratories.humanness-score.software:main")

self.defineOutputs("result")


self.body(func(args) {

	inputTable := args.table

	baseMemGiB := 16
	if !is_undefined(args.mem) {
		baseMemGiB = args.mem
	}

	// Run the humanness scoring tool on the sequences.
	humannessCalcCmd := exec.builder().
		software(humannessCalcSw).
		mem(string(int(math.max(16, baseMemGiB))) + "GiB").
		cpu(1).
		addFile("input.parquet", inputTable).
		arg("input.parquet").
		arg("result.parquet").
		saveFile("result.parquet")

	humannessResult := humannessCalcCmd.run()

	result := humannessResult.getFile("result.parquet")

	return {
		result: result
	}
})
