// Peptide-mode post-processing. Imports the result TSV from peptide-liabilities.tpl.tengo
// as a pframe with the variantKey axis and a single humanness_score column.

self := import("@platforma-sdk/workflow-tengo:tpl")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
ll := import("@platforma-sdk/workflow-tengo:ll")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
json := import("json")
math := import("math")

self.defineOutputs("outputLiabilities", "exportPframe")


self.body(func(args) {

    blockId := args.blockId
    customBlockLabel := args.customBlockLabel
    defaultBlockLabel := args.defaultBlockLabel
    liabilitiesTable := args.liabilitiesTable
    datasetSpec := args.datasetSpec

    baseMemGiB := 16
    if !is_undefined(args.mem) {
        baseMemGiB = args.mem
    }
    convMemGiB := string(int(math.max(8, baseMemGiB / 4))) + "GiB"

    variantKeySpec := datasetSpec.axesSpec[1]

    axes := [
        {
            column: "variantKey",
            spec: variantKeySpec
        }
    ]

    columns := [
        {
            column: "peptide_aa",
            id: "peptide-aa",
            naRegex: "",
            allowNA: true,
            spec: {
                name: "pl7.app/sequence",
                valueType: "String",
                domain: {
                    "pl7.app/feature": "peptide",
                    "pl7.app/alphabet": "aminoacid"
                },
                annotations: {
                    "pl7.app/label": "Peptide aa",
                    "pl7.app/isMainSequence": "true",
                    "pl7.app/table/fontFamily": "monospace",
                    "pl7.app/table/visibility": "default",
                    "pl7.app/table/orderPriority": "200"
                }
            }
        },
        {
            column: "humanness_score",
            id: "humannessScore",
            naRegex: "",
            allowNA: true,
            spec: {
                name: "pl7.app/humannessScore",
                valueType: "Double",
                annotations: {
                    "pl7.app/label": "Humanness Score",
                    "pl7.app/description": "Promb / OASis (human-oas) humanness score in [0, 100]; fraction of 9-mers found in human antibody repertoires, rescaled. Higher = more human.",
                    "pl7.app/table/visibility": "default",
                    "pl7.app/table/orderPriority": "100",
                    "pl7.app/format": ".2~f",
                    "pl7.app/isScore": "true",
                    "pl7.app/score/rankingOrder": "decreasing",
                    "pl7.app/score/method": "promb / OASis (human-oas)"
                }
            }
        }
    ]

    // All columns are exported; tag blockId in domain.
    exportColumns := []
    for col in columns {
        if !col.spec.domain {
            col.spec.domain = {}
        }
        col.spec.domain["pl7.app/blockId"] = blockId
        exportColumns += [col]
    }

    outputSpecs := {
        axes: axes,
        columns: columns,
        storageFormat: "Parquet",
        partitionKeyLength: 0
    }

    exportSpecs := {
        axes: axes,
        columns: exportColumns,
        storageFormat: "Parquet",
        partitionKeyLength: 0
    }

    outputLiabilities := xsv.importFile(
        liabilitiesTable,
        "tsv",
        outputSpecs,
        { cpu: 1, mem: convMemGiB }
    )

    exportOutput := xsv.importFile(
        liabilitiesTable,
        "tsv",
        exportSpecs,
        { splitDataAndSpec: true, cpu: 1, mem: convMemGiB }
    )

    blockLabel := customBlockLabel || defaultBlockLabel || "Humanness Score"

    traceSteps := [{
        type: "milaboratories.humanization-score",
        importance: 30,
        label: blockLabel,
        id: blockId
    }]
    humannessTrace := pSpec.makeTrace(datasetSpec, traceSteps...)

    exportPframe := pframes.pFrameBuilder()
    for k, v in exportOutput {
        exportPframe.add(k, humannessTrace.inject(v.spec), v.data)
    }
    exportPframe = exportPframe.build()

    return {
        outputLiabilities: pframes.exportFrame(outputLiabilities),
        exportPframe: exportPframe
    }
})
