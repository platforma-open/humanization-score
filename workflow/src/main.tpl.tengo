wf := import("@platforma-sdk/workflow-tengo:workflow")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")
assets := import("@platforma-sdk/workflow-tengo:assets")
ll := import("@platforma-sdk/workflow-tengo:ll")
pFrames := import("@platforma-sdk/workflow-tengo:pframes")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pt := import("@platforma-sdk/workflow-tengo:pt")
math := import("math")

calculateHumannessTpl := assets.importTemplate(":clonotype-humanness")
processTpl := assets.importTemplate(":clonotype-process")

// Prepare phase of the workflow - collects and sets up required data
wf.prepare(func(args) {

	bundleBuilder := wf.createPBundleBuilder()
	bundleBuilder.ignoreMissingDomains()
	bundleBuilder.addAnchor("main", args.inputAnchor)

	// Collect all amino acid sequences from the input data
	bundleBuilder.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		annotations: {
			"pl7.app/vdj/isAssemblingFeature": "true"
		},
		domain: {
			"pl7.app/alphabet": "aminoacid"
			}
		}, "sequences")

	bundleBuilder.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence/annotation",
		annotations: {
			"pl7.app/sequence/isAnnotation": "true"
		},
		domain: {
			"pl7.app/alphabet": "aminoacid",
          	"pl7.app/sequence/annotation/type": "CDRs"
		}
	}, "annotations")

	bundleBuilder.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/alphabet": "aminoacid"
		}
	}, "additionalSequences")

	// Primary, non-normalized abundance carries the [sampleId, clonotypeKey] axes.
	// We use it purely as the per-sample membership: which clonotypes appear in
	// which samples, so the per-clonotype humanness score can be broadcast per
	// sample (see wf.body). Optional — datasets without it just skip that output.
	bundleBuilder.addMulti({
		axes: [{ anchor: "main", idx: 0 }, { anchor: "main", idx: 1 }],
		annotations: {
			"pl7.app/isAbundance": "true",
			"pl7.app/abundance/normalized": "false",
			"pl7.app/abundance/isPrimary": "true"
		}
	}, "abundance")

		return {
			columns: bundleBuilder.build()
		}
	}
)

wf.body(func(args) {

	blockId := wf.blockId().getDataAsJson()

	columnsWithSequences := args.columns
	datasetSpec := columnsWithSequences.getSpec(args.inputAnchor)

	baseMemGiB := 16
	if !is_undefined(args.mem) {
		baseMemGiB = args.mem
	}

	sequences := columnsWithSequences.getColumns("sequences")
	annotations := columnsWithSequences.getColumns("annotations")
	additionalSequences := columnsWithSequences.getColumns("additionalSequences")
	// Determine if we're working with single cell data
	isSingleCell := datasetSpec.axesSpec[1].name == "pl7.app/vdj/scClonotypeKey"

	seqTableBuilder := pFrames.parquetFileBuilder()
	seqTableBuilder.setAxisHeader(datasetSpec.axesSpec[1], "clonotypeKey")

	if len(sequences) == 0 {
		ll.panic("No sequences found in the input data.")
	}

	hasAnnotations := len(annotations) > 0

	// Track which features are present, to avoid emitting duplicate
	// sequence-table headers below.
	coveredFeatures := {}

	if isSingleCell {
		// Single-cell data handling
		// Add primary chain sequences
		for seq_entry in sequences {
			if seq_entry.spec.name == "pl7.app/vdj/scFv-sequence" {
				for additionalSeq in additionalSequences {
					if additionalSeq.spec.domain["pl7.app/vdj/scClonotypeChain/index"] == "primary" {
						for fr in ["CDR1", "CDR2", "CDR3", "FR1"] {
							if additionalSeq.spec.domain["pl7.app/vdj/feature"] == fr {
								chain := additionalSeq.spec.domain["pl7.app/vdj/scClonotypeChain"]
								chainLabel := (chain == "A" ? "Heavy" : "Light")
								seqTableBuilder.add(columnsWithSequences.getColumn(additionalSeq.key), {header: chainLabel + " " + fr + " aa"})
								if coveredFeatures[fr] {
									coveredFeatures[fr] += 1
								} else {
									coveredFeatures[fr] = 1
								}
							}
						}
					}
				}
			} else if seq_entry.spec.domain["pl7.app/vdj/scClonotypeChain/index"] == "primary" {
				chain := seq_entry.spec.domain["pl7.app/vdj/scClonotypeChain"]
				chainLabel := (chain == "A" ? "Heavy" : "Light")
				seqTableBuilder.add(columnsWithSequences.getColumn(seq_entry.key), {header: chainLabel + " " + " sequence aa"})
			}
		}
		// Add primary chain annotations if they exist
		if hasAnnotations {
			for ann_entry in annotations {
				if ann_entry.spec.domain["pl7.app/vdj/scClonotypeChain/index"] == "primary" {
					chain := ann_entry.spec.domain["pl7.app/vdj/scClonotypeChain"]
					chainLabel := (chain == "A" ? "Heavy" : "Light")
					// Python script expects annotation columns to end with "annotations"
					// and might derive prefix like "Heavy CDRs" or "Light CDRs"
					seqTableBuilder.add(columnsWithSequences.getColumn(ann_entry.key), {header: chainLabel + " annotations"})
				}
			}
		}
	} else { // Bulk data handling
		// Add the primary assembling feature sequence.
		// Mark it in coveredFeatures so the additionalSequences loop below skips it.
		// On imported data, CDR3 satisfies both the assembling-feature query (sequences)
		// and the region query (additionalSequences), so without this guard the TSV
		// builder would receive "CDR3 aa" twice and throw a duplicate-header error.
		if len(sequences) > 0 {
			if sequences[0].spec.domain["pl7.app/vdj/feature"] == "CDR3" {
				seqTableBuilder.add(columnsWithSequences.getColumn(sequences[0].key), {header: "CDR3 aa"})
				coveredFeatures["CDR3"] = 1
			} else {
				seqTableBuilder.add(columnsWithSequences.getColumn(sequences[0].key), {header: "sequence aa"})
			}
		}
		// Add FR/CDR sequences from additionalSequences (bulk, no annotations)
		for additionalSeq in additionalSequences {
			for fr in ["CDR1", "CDR2", "CDR3", "FR1", "FR2", "FR3"] {
				if additionalSeq.spec.domain["pl7.app/vdj/feature"] == fr && !coveredFeatures[fr] {
					seqTableBuilder.add(columnsWithSequences.getColumn(additionalSeq.key), {header: fr + " aa"})
					if coveredFeatures[fr] {
						coveredFeatures[fr] += 1
					} else {
						coveredFeatures[fr] = 1
					}
				}
			}
		}
		// Add annotations if they exist
		if hasAnnotations {
			// Python script expects annotation column to end with "annotations"
			seqTableBuilder.add(columnsWithSequences.getColumn(annotations[0].key), {header: "Annotations"})
		}
	}

	seqTableBuilder.mem(string(int(math.max(16, baseMemGiB / 4))) + "GiB")
	seqTableBuilder.cpu(1)
	seqTable := seqTableBuilder.build()

	humannessResultCalc := render.create(calculateHumannessTpl, {
		table: seqTable
	}, {
		// mem only affects resource allocation, not the result, so pass it as a
		// meta input to avoid re-executing the template when memory changes.
		metaInputs: {
			mem: args.mem
		}
	})

	humannessResult := humannessResultCalc.output("result", 24 * 60 * 60 * 1000)

	processResult := render.create(processTpl, {
		humannessTable: humannessResult,
		blockId: blockId,
		customBlockLabel: args.customBlockLabel,
		params: smart.createJsonResource({
			datasetSpec: datasetSpec
		})
	}, {
		// mem only affects resource allocation, not the result, so pass it as a
		// meta input to avoid re-executing the template when memory changes.
		metaInputs: {
			mem: args.mem
		}
	})

	outputHumanness := processResult.output("outputHumanness", 24 * 60 * 60 * 1000)
	exportPframe := processResult.output("exportPframe", 24 * 60 * 60 * 1000)

	outputs := {
		outputHumanness: outputHumanness
	}

	// --- Per-sample humanness pframe -----------------------------------------
	// The humanness score is computed once per clonotype (it is sample-independent:
	// same sequence -> same score). To expose a per-sample distribution with
	// sampleId as a *real axis in the column spec* — rather than relying on a
	// graph-maker-side join at plot time — we broadcast each clonotype's score
	// across the samples it appears in: inner-join the score table (keyed by
	// clonotypeKey) with the input's primary-abundance membership (keyed by
	// [sampleId, clonotypeKey]) on clonotypeKey, then import the result as a
	// pframe whose single column carries both axes.
	// Degrades gracefully: a dataset with no primary-abundance column simply
	// doesn't emit this output and the By-sample page stays empty.
	convMemGiB := string(int(math.max(16, baseMemGiB / 4))) + "GiB"
	abundanceColumns := columnsWithSequences.getColumns("abundance")
	if len(abundanceColumns) > 0 {
		sampleAxisSpec := datasetSpec.axesSpec[0]
		clonotypeKeySpec := datasetSpec.axesSpec[1]

		// Membership table: one row per (sampleId, clonotypeKey) present in the input.
		membershipBuilder := pFrames.parquetFileBuilder()
		membershipBuilder.setAxisHeader(sampleAxisSpec, "sampleId")
		membershipBuilder.setAxisHeader(clonotypeKeySpec, "clonotypeKey")
		membershipBuilder.add(columnsWithSequences.getColumn(abundanceColumns[0].key), {header: "abundance"})
		membershipBuilder.mem(convMemGiB)
		membershipBuilder.cpu(1)
		membershipTable := membershipBuilder.build()

		// Inner join broadcasts the single per-clonotype score onto every
		// (sample, clonotype) pair the clonotype belongs to.
		ptw := pt.workflow()
		scoreDf := ptw.frame(humannessResult, {format: "parquet"})
		memberDf := ptw.frame(membershipTable, {format: "parquet"})
		perSampleDf := memberDf.join(scoreDf, {
			how: "inner",
			on: "clonotypeKey",
			leftColumns: ["sampleId", "clonotypeKey"],
			rightColumns: ["humanness_score"]
		})
		perSampleDf.save("per-sample-humanness.parquet")
		ptRes := ptw.run()
		perSampleParquet := ptRes.getFile("per-sample-humanness.parquet")

		// Import via the same proven path as the per-clonotype output, but with
		// sampleId declared as a real first axis in the spec.
		perSampleSpecs := {
			axes: [
				{ column: "sampleId", spec: sampleAxisSpec },
				{ column: "clonotypeKey", spec: clonotypeKeySpec }
			],
			columns: [
				{
					column: "humanness_score",
					id: "humannessScore",
					allowNA: true,
					spec: {
						name: "pl7.app/humannessScore",
						valueType: "Double",
						domain: {
							"pl7.app/blockId": blockId
						},
						annotations: {
							"pl7.app/label": "Humanness Score",
							"pl7.app/description": "Promb / OASis (human-oas) humanness score in [0, 100]; fraction of 9-mers found in human antibody repertoires, rescaled. Higher = more human.",
							"pl7.app/format": ".2~f",
							"pl7.app/isScore": "true",
							"pl7.app/score/rankingOrder": "decreasing",
							"pl7.app/score/method": "promb / OASis (human-oas)"
						}
					}
				}
			],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}

		perSampleImported := xsv.importFile(perSampleParquet, "parquet", perSampleSpecs, {splitDataAndSpec: true, cpu: 1, mem: convMemGiB})

		perSampleBuilder := pFrames.pFrameBuilder()
		for k, v in perSampleImported {
			perSampleBuilder.add(k, v.spec, v.data)
		}
		outputs.perSamplePf = pFrames.exportFrame(perSampleBuilder.build())
	}

	return {
		outputs: outputs,
		exports: {
			exportPframe: exportPframe
		}
	}
})
