wf := import("@platforma-sdk/workflow-tengo:workflow")
render := import("@platforma-sdk/workflow-tengo:render")
smart := import("@platforma-sdk/workflow-tengo:smart")
assets := import("@platforma-sdk/workflow-tengo:assets")
ll := import("@platforma-sdk/workflow-tengo:ll")
pFrames := import("@platforma-sdk/workflow-tengo:pframes")
math := import("math")

calculateHumannessTpl := assets.importTemplate(":clonotype-humanness")
processTpl := assets.importTemplate(":clonotype-process")

// Canonical variable-region features, in natural N->C order. When no fully
// assembled VDJRegion column is present we fall back to these per-region
// amino-acid columns and let the Python scorer assemble a contiguous partial
// domain per row (see body + software/src/main.py:assemble_and_score).
allFeatures := ["FR1", "CDR1", "FR2", "CDR2", "FR3", "CDR3", "FR4"]

// Non-fatal warning surfaced when there is nothing assemblable at all. Per the
// spec (correct-behavior §3a/§7) the absence of any scoreable variable-region
// material is NOT an error: the score is honestly "not computable" (null), the
// run completes, and we explain why via the `warnings` output. This must NOT
// crash the run. Note: a dataset that DOES provide FR/CDR columns but covers
// fewer than 3 framework regions is NOT warned here — it yields a built unit
// whose per-row score is null'd by the coverage gate in the Python scorer,
// which is the honest result.
NO_FULL_DOMAIN_WARNING := "Humanness scoring needs a contiguous variable-region domain covering at least 3 of the 4 framework regions. This dataset provides no assemblable variable-region features (no VDJRegion and no FR/CDR amino-acid columns); the score is null. Re-run clonotyping with full or partial (>=3 FR) variable-region assembly to obtain humanness scores."

// TCR is a HARD reject (spec R5): the block does not apply to T-cell receptors,
// whose repertoire (OAS) contains no TCR data. This stays a fatal ll.panic.
TCR_MESSAGE := "Humanness scoring applies to antibodies only; TCR input is not supported."

// A dataset keyed on pl7.app/variantKey by a producer we do not recognise. Named rather than
// absorbed into the nearest branch: the axis is shared vocabulary and the run-id key in its
// domain is what says who produced it, so an unknown run-id is an unknown data shape and
// guessing at it is how a peptide set ends up being scored as an antibody.
UNKNOWN_PRODUCER_MESSAGE := "This dataset is keyed on pl7.app/variantKey but carries no producer run-id this block recognises. Humanness scoring accepts receptor sets stamped with pl7.app/vdj/clonotypingRunId (imported antibody sets from Import VDJ Data); peptide and amplicon sets are not scoreable."

// Prepare phase of the workflow - collects and sets up required data
wf.prepare(func(args) {

	bundleBuilder := wf.createPBundleBuilder()
	bundleBuilder.ignoreMissingDomains()
	bundleBuilder.addAnchor("main", args.inputAnchor)

	// Preferred source: the fully assembled variable domain (FR1..FR4 already
	// glued). For the amino-acid alphabet the producer rewrites VDJRegion ->
	// VDJRegionInFrame, so we must match VDJRegionInFrame here (plain VDJRegion is
	// the nucleotide column). When present (per chain) this is used directly.
	bundleBuilder.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/alphabet": "aminoacid",
			"pl7.app/vdj/feature": "VDJRegionInFrame"
		}
	}, "vdjRegions")

	// Fallback source: the per-region amino-acid columns. When a chain has no
	// VDJRegion column the body feeds these region columns to the scorer, which
	// assembles a contiguous partial domain per row and applies the >=3-framework
	// coverage gate. Same split as paratope-clustering: tengo pulls/orders the
	// per-region columns, Python concatenates per row.
	for feature in allFeatures {
		bundleBuilder.addMulti({
			axes: [{ anchor: "main", idx: 1 }],
			name: "pl7.app/vdj/sequence",
			domain: {
				"pl7.app/vdj/feature": feature,
				"pl7.app/alphabet": "aminoacid"
			}
		}, feature)
	}

	// FR4 can also be named FR4InFrame in some datasets; pull it as a per-chain
	// fallback for the FR4 slot.
	bundleBuilder.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/vdj/sequence",
		domain: {
			"pl7.app/vdj/feature": "FR4InFrame",
			"pl7.app/alphabet": "aminoacid"
		}
	}, "FR4InFrame")

	return {
		columns: bundleBuilder.build()
	}
})

wf.body(func(args) {

	columnsWithSequences := args.columns
	datasetSpec := columnsWithSequences.getSpec(args.inputAnchor)

	baseMemGiB := 16
	if !is_undefined(args.mem) {
		baseMemGiB = args.mem
	}

	keyAxisSpec := datasetSpec.axesSpec[1]
	keyAxisDomain := is_undefined(keyAxisSpec.domain) ? {} : keyAxisSpec.domain

	// MODALITY comes from the run-id key on the key axis, never from the axis name.
	// `pl7.app/variantKey` is shared vocabulary; three producers key on it and only the
	// run-id in its domain says which:
	//
	//   pl7.app/peptide/extractionRunId      peptide-extraction              -> peptides
	//   pl7.app/repertoire/extractionRunId   synthetic-repertoire-profiler   -> amplicons
	//   pl7.app/vdj/clonotypingRunId         import-vdj-data, bare set       -> receptors
	//
	// The model's selectors already keep the first two out of the dropdown (neither stamps
	// pl7.app/vdj/receptor on the axis). This is the backstop, and it REFUSES an unrecognised
	// producer naming the accepted ones rather than falling through to the nearest branch —
	// falling through is what sent bare sets down peptide paths in four other blocks.
	if keyAxisSpec.name == "pl7.app/variantKey" &&
		is_undefined(keyAxisDomain["pl7.app/vdj/clonotypingRunId"]) {
		ll.panic(UNKNOWN_PRODUCER_MESSAGE)
	}

	// Ig only (spec R5). Where the receptor is stated on the key axis — single-cell, and a
	// bare imported set — read it there. A bulk clonotypeKey axis names the CHAIN instead,
	// using the producer's chainInfos KEYS rather than the mixcr filter values:
	// IG = "IGHeavy"/"IGLight", TCR = "TCRAlpha"/"TCRBeta"/"TCRGamma"/"TCRDelta".
	receptor := keyAxisDomain["pl7.app/vdj/receptor"]
	if !is_undefined(receptor) {
		if receptor != "IG" {
			ll.panic(TCR_MESSAGE)
		}
	} else {
		chain := keyAxisDomain["pl7.app/vdj/chain"]
		if !(chain == "IGHeavy" || chain == "IGLight") {
			ll.panic(TCR_MESSAGE)
		}
	}

	vdjRegions := columnsWithSequences.getColumns("vdjRegions")

	rawFeatureColumns := {}
	for feature in allFeatures {
		rawFeatureColumns[feature] = columnsWithSequences.getColumns(feature)
	}
	rawFr4InFrame := columnsWithSequences.getColumns("FR4InFrame")

	// ARRANGEMENT — whether both chains sit side by side in ONE frame, separated by the
	// pl7.app/vdj/scClonotypeChain COLUMN domain. The marker is that chain letter-domain, NOT
	// the key axis name: single-cell is the long-standing case, and a PAIRED bare set from
	// import-vdj-data is the new one, carrying the same column domain on a variantKey axis.
	// So isSingleCell is SEEDED from the axis name and WIDENED by the columns — the same
	// widening paratope-clustering (main.tpl.tengo:107) and clonotype-clustering (:117) apply.
	//
	// The widening tests `/index`, not the bare `pl7.app/vdj/scClonotypeChain`, because
	// `/index == "primary"` is what the code below REQUIRES: normalizePrimaryChainOrder and
	// chainColumnFor both `continue` on anything else, absent included. A dataset carrying the
	// chain key without `/index` would therefore flip this flag and then have every column
	// filtered out — zero units, the "nothing assemblable" warning, a null score. Several
	// producers do stamp the chain key alone (mixcr-scfv gene hits, immuno-match,
	// sequence-properties, clonotype-convergence); none on a variantKey axis today, so this is
	// latent rather than live, but the test has to match what the consumer needs.
	//
	// Gated on the axis actually being variantKey, as clonotype-clustering gates it (:118): the
	// only shape this widening exists for is a paired bare set, and the narrower test keeps a
	// stray chain-domain column on some other key axis from silently switching paths.
	//
	// Reading arrangement off the axis name sent a paired bare set down the bulk path, where
	// chainColumnFor returns cols[0]: one chain would be scored, the other silently dropped,
	// and the result would still look complete.
	//
	// A SINGLE-chain bare set carries no chain domain at all — import-vdj-data stamps it only
	// when both chains are mapped, deliberately, so that a one-chain import is bulk-shaped —
	// and it therefore keeps the bulk path, which is the right one for it.
	chainScanCols := vdjRegions
	for feature in allFeatures {
		chainScanCols += rawFeatureColumns[feature]
	}
	chainScanCols += rawFr4InFrame

	isSingleCell := keyAxisSpec.name == "pl7.app/vdj/scClonotypeKey"
	if !isSingleCell && keyAxisSpec.name == "pl7.app/variantKey" {
		for col in chainScanCols {
			if !is_undefined(col.spec.domain["pl7.app/vdj/scClonotypeChain/index"]) {
				isSingleCell = true
			}
		}
	}

	// For single-cell data: keep only primary chains AND order them
	// deterministically by scClonotypeChain (A before B). Bulk columns have no
	// scClonotypeChain/index domain key, so this normalization is skipped for
	// bulk data. Filtering out index != "primary" is what keeps secondary-rank
	// (CDR3-only) rearrangements out of the scored table -> they stay null.
	normalizePrimaryChainOrder := func(cols) {
		if !isSingleCell {
			return cols
		}
		byChain := {}
		for col in cols {
			if col.spec.domain["pl7.app/vdj/scClonotypeChain/index"] != "primary" {
				continue
			}
			sc := col.spec.domain["pl7.app/vdj/scClonotypeChain"]
			byChain[sc] = col
		}
		ordered := []
		for _, k in ["A", "B"] {
			if !is_undefined(byChain[k]) {
				ordered = append(ordered, byChain[k])
			}
		}
		return ordered
	}

	// Per-region columns (primary-only + A-before-B for single-cell), keyed by
	// feature, with the FR4 -> FR4InFrame fallback applied per chain so a chain
	// that only carries FR4InFrame still fills its FR4 slot.
	featureColumns := {}
	for feature in allFeatures {
		featureColumns[feature] = normalizePrimaryChainOrder(rawFeatureColumns[feature])
	}
	fr4InFrame := normalizePrimaryChainOrder(rawFr4InFrame)

	// Build one scoring unit per chain type. Each unit's table holds the
	// clonotype-key axis plus EITHER a single "VDJRegion aa" column (full-domain
	// fast path) OR this chain's per-region "FR1 aa".."FR4 aa" columns (assembled
	// path). A table never mixes chains, and the region path never mixes the two
	// shapes (VDJRegion takes precedence per chain). The Python scorer assembles
	// the contiguous domain and applies the >=3-framework coverage gate per row.
	convMemGiB := string(int(math.max(16, baseMemGiB / 4))) + "GiB"

	// pairs is a list of {col, header}; headers must match the scorer's expected
	// names exactly ("VDJRegion aa", or canonical "FR1 aa".."FR4 aa").
	buildUnitTable := func(pairs) {
		b := pFrames.parquetFileBuilder()
		b.setAxisHeader(datasetSpec.axesSpec[1], "clonotypeKey")
		for pair in pairs {
			b.add(pair.col, {header: pair.header})
		}
		b.mem(convMemGiB)
		b.cpu(1)
		return b.build()
	}

	// Resolve the source for one chain. `chain` is the scClonotypeChain value for
	// single-cell, or undefined for bulk. Returns the list of {col, header} pairs
	// for that chain, or [] when nothing is assemblable. Prefers VDJRegion (one
	// "VDJRegion aa" column); otherwise gathers the chain's per-region columns in
	// canonical order, FR4 falling back to FR4InFrame.
	chainColumnFor := func(cols, chain) {
		if isSingleCell {
			for col in cols {
				if col.spec.domain["pl7.app/vdj/scClonotypeChain/index"] != "primary" {
					continue
				}
				if col.spec.domain["pl7.app/vdj/scClonotypeChain"] == chain {
					return col
				}
			}
			return undefined
		}
		if len(cols) > 0 {
			return cols[0]
		}
		return undefined
	}

	selectPairsFor := func(chain) {
		// Fast path: full domain present for this chain -> single column only.
		vdjCol := chainColumnFor(vdjRegions, chain)
		if !is_undefined(vdjCol) {
			return [{ col: vdjCol, header: "VDJRegion aa" }]
		}
		// Fallback: per-region columns for this chain, canonical order.
		pairs := []
		for feature in allFeatures {
			featCol := chainColumnFor(featureColumns[feature], chain)
			if feature == "FR4" && is_undefined(featCol) {
				featCol = chainColumnFor(fr4InFrame, chain)
			}
			if !is_undefined(featCol) {
				pairs += [{ col: featCol, header: feature + " aa" }]
			}
		}
		return pairs
	}

	units := []

	if isSingleCell {
		// Score the PRIMARY-rank rearrangement of each chain type (A=Heavy,
		// B=Light). Secondary-rank rows are filtered out (index != "primary")
		// in both the VDJRegion and the per-region selection, so they produce
		// null for that chain. The null rule keys on index == "secondary",
		// never on Heavy-vs-Light.
		for _, chain in ["A", "B"] {
			pairs := selectPairsFor(chain)
			if len(pairs) == 0 {
				continue
			}
			chainLabel := (chain == "A" ? "Heavy" : "Light")
			units += [{
				id: "humannessScore" + chain,
				table: buildUnitTable(pairs),
				chain: chain,
				chainLabel: chainLabel
			}]
		}
	} else {
		// Bulk / VHH: a single chain. Prefer the VDJRegionInFrame aa column; else
		// assemble from this chain's per-region columns.
		pairs := selectPairsFor(undefined)
		if len(pairs) > 0 {
			units += [{
				id: "humannessScore",
				table: buildUnitTable(pairs),
				chain: undefined,
				chainLabel: undefined
			}]
		}
	}

	// Nothing assemblable at all (neither a VDJRegion column nor any per-region
	// FR/CDR column for any chain) => the legitimate "unscoreable" path, NOT an
	// error. Instead of panicking we surface a non-fatal warning and emit an
	// empty result; the run completes and the score is honestly null. A dataset
	// that DOES provide region columns but covers <3 framework regions is NOT
	// warned here: it yields a built unit whose per-row score is null'd by the
	// coverage gate in the Python scorer. See spec correct-behavior §3a/§7.
	// (TCR remains a hard reject above, per R5.)
	warnings := []
	if len(units) == 0 {
		warnings += [NO_FULL_DOMAIN_WARNING]
	}

	// Run the scorer once per unit, then hand all scored tables (plus their
	// chain metadata) to a single process template that imports them into
	// per-chain PColumns. We pass the units as a map resource keyed by unit id
	// so the resource handles survive the render boundary. When units is empty
	// (no full variable region), the map is empty and the process template's
	// for-loop produces empty pFrames — a valid empty result, no crash.
	unitsBuilder := smart.mapBuilder()
	for unit in units {
		humannessResultCalc := render.create(calculateHumannessTpl, {
			table: unit.table
		}, {
			// mem only affects resource allocation, not the result, so pass it as
			// a meta input to avoid re-executing the template when memory changes.
			metaInputs: {
				mem: args.mem
			}
		})

		humannessResult := humannessResultCalc.output("result", 24 * 60 * 60 * 1000)

		// Only carry chain metadata for single-cell; bulk has a single chainless
		// unit. Avoid undefined values in the map resource.
		unitValue := {
			humannessTable: humannessResult
		}
		if !is_undefined(unit.chain) {
			unitValue.chain = unit.chain
			unitValue.chainLabel = unit.chainLabel
		}
		unitsBuilder.add(unit.id, unitValue)
	}
	unitsResource := unitsBuilder.build()

	clonotypeKeySpec := datasetSpec.axesSpec[1]
	datasetLabel := ""
	traceAnnotations := {}
	if !is_undefined(datasetSpec.annotations) {
		if !is_undefined(datasetSpec.annotations["pl7.app/label"]) {
			datasetLabel = datasetSpec.annotations["pl7.app/label"]
		}
		if !is_undefined(datasetSpec.annotations["pl7.app/trace"]) {
			traceAnnotations = { "pl7.app/trace": datasetSpec.annotations["pl7.app/trace"] }
		}
	}

	processResult := render.create(processTpl, {
		units: unitsResource,
		customBlockLabel: args.customBlockLabel,
		params: smart.createJsonResource({
			clonotypeKeySpec: clonotypeKeySpec,
			isSingleCell: isSingleCell,
			datasetLabel: datasetLabel,
			traceAnnotations: traceAnnotations
		})
	}, {
		// mem only affects resource allocation, not the result, so pass it as a
		// meta input to avoid re-executing the template when memory changes.
		metaInputs: {
			mem: args.mem
		}
	})

	outputHumanness := processResult.output("outputHumanness", 24 * 60 * 60 * 1000)
	exportPframe := processResult.output("exportPframe", 24 * 60 * 60 * 1000)

	return {
		outputs: {
			outputHumanness: outputHumanness,
			// Non-fatal warnings (JSON array of strings; empty when scoring
			// succeeded). The workflow-tengo SDK has no dedicated notification
			// channel, so a regular JSON output resource is the idiomatic way to
			// surface a non-fatal message; the model/UI reads it as a banner.
			warnings: smart.createJsonResource(warnings)
		},
		exports: {
			exportPframe: exportPframe
		}
	}
})
