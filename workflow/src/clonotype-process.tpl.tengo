self := import("@platforma-sdk/workflow-tengo:tpl")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
maps := import("@platforma-sdk/workflow-tengo:maps")
ll := import("@platforma-sdk/workflow-tengo:ll")
smart := import("@platforma-sdk/workflow-tengo:smart")
math := import("math")

self.defineOutputs("outputHumanness", "exportPframe")


self.body(func(args) {

	customBlockLabel := args.customBlockLabel

	// Content tag for the exported column, replacing the per-block blockId. We use
	// the backend's own content key of the scored table (info().CanonicalID, base32
	// encoded). Identical scoring results across blocks therefore share the same tag
	// — so the columns are content-identical (dedupe-friendly) instead of being made
	// unique per block — while different results get different tags (no collision).
	// CanonicalID is deterministic for identical content (verified: identical inputs
	// produce the same CanonicalID across runs).
	contentTag := func(table) {
		i := table.info()
		if !is_undefined(i.CanonicalID) {
			return ll.base32Encode(i.CanonicalID)
		}
		// Field reference: dereference to its value resource.
		ri := smart.resource(i.Value).info()
		return ll.base32Encode(ri.CanonicalID)
	}

	baseMemGiB := 16
	if !is_undefined(args.mem) {
		baseMemGiB = args.mem
	}
	convMemGiB := string(int(math.max(16, baseMemGiB / 4))) + "GiB"

	// main.tpl.tengo forwards only the slices of datasetSpec this template needs
	// (the clonotype-key axis spec, the dataset's fallback label, and the trace
	// annotation), so an unrelated change in datasetSpec does not bust this cache.
	params := args.params
	isSingleCell := params.isSingleCell

	// One scoring unit per chain type. Bulk has a single unit (no chain split);
	// single-cell has up to two (A=Heavy, B=Light), each scored from its OWN
	// parquet so the "humanness_score" column name never collides across units.
	//
	// An EMPTY `units` map is a legitimate, non-error state: it is the
	// "no full variable region available" path (CDR3-assembled dataset or
	// partial-domain features) routed here by main.tpl.tengo. In that case the
	// for-loop below adds nothing, the builders yield empty pFrames, and
	// pframes.exportFrame of an empty frame is a valid empty result. Do NOT
	// re-add a guard/panic here — the null/empty result + a non-fatal warning is
	// the spec-mandated behavior (correct-behavior §3a/§7).
	units := args.units

	clonotypeKeySpec := params.clonotypeKeySpec

	// Fall back to the input dataset name when the user has not set a custom
	// label, keeping the provenance trace consistent with the block subtitle.
	blockLabel := customBlockLabel
	if blockLabel == "" {
		blockLabel = params.datasetLabel
		if blockLabel == "" {
			blockLabel = "Humanness Score"
		}
	}

	// The trace step is no longer keyed on blockId (the block is no longer the
	// identity of the score; its content is). `id` is optional in the trace schema;
	// omitting it keeps the provenance step identical across content-identical runs.
	traceSteps := [{
		type: "milaboratories.humanness-score",
		importance: 30,
		label: blockLabel
	}]

	// makeTrace seeds the provenance chain from the input's "pl7.app/trace"
	// annotation only; main forwards just that annotation wrapped in a minimal
	// stub. An empty stub ({}) yields a fresh (empty) trace, same as before.
	humannessTrace := pSpec.makeTrace({ annotations: params.traceAnnotations }, traceSteps...)

	outputBuilder := pframes.pFrameBuilder()
	exportPframe := pframes.pFrameBuilder()

	// Build one humanness-score PColumn per unit and merge them into the same
	// output / export frames. Heavy (A) sorts first via a higher orderPriority.
	for unitId, unit in units {
		chain := unit.chain
		chainLabel := unit.chainLabel

		label := "Humanness Score"
		orderPriority := "100"
		domain := {}
		columnId := "humannessScore"

		if isSingleCell {
			label = "Humanness Score, " + chainLabel
			columnId = "humannessScore" + chain
			domain = {
				"pl7.app/vdj/scClonotypeChain": chain
			}
			// Heavy (A) sorts before Light (B).
			if chain != "A" {
				orderPriority = "99"
			}
		}

		// Content-address the column by the canonical id of its scored data instead
		// of scoping it to the block instance: identical results across blocks unify
		// (dedupe), different results stay distinct (no collision).
		domain["pl7.app/blockId"] = contentTag(unit.humannessTable)

		annotations := {
			"pl7.app/label": label,
			"pl7.app/description": "OASis identity (promb / human-oas): fraction of overlapping 9-mer peptides found in human OAS antibody repertoires, x100 (range 0-100; higher = more human). NOTE: this is the raw OASis IDENTITY, NOT the calibrated OASis percentile — it is not directly comparable to BioPhi's published '% human' percentiles.",
			"pl7.app/table/visibility": "default",
			"pl7.app/table/orderPriority": orderPriority,
			"pl7.app/format": ".2~f",
			"pl7.app/isScore": "true",
			"pl7.app/score/rankingOrder": "decreasing",
			"pl7.app/score/method": "promb / OASis identity (human-oas)"
		}

		importSpecs := {
			axes: [
				{
					column: "clonotypeKey",
					spec: clonotypeKeySpec
				}
			],
			columns: [{
				column: "humanness_score",
				id: columnId,
				allowNA: true,
				spec: {
					name: "pl7.app/humannessScore",
					valueType: "Double"
				}
			}],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}

		importedColumns := xsv.importFile(
			unit.humannessTable,
			"parquet",
			importSpecs,
			{splitDataAndSpec: true, cpu: 1, mem: convMemGiB}
		)

		for k, v in importedColumns {
			fullSpec := maps.deepMerge(v.spec, {
				domain: domain,
				annotations: annotations
			})
			outputBuilder.add(k, fullSpec, v.data)
			exportPframe.add(k, humannessTrace.inject(fullSpec), v.data)
		}
	}

	outputHumanness := outputBuilder.build()
	exportPframe = exportPframe.build()

	return {
		outputHumanness: pframes.exportFrame(outputHumanness),
		exportPframe: exportPframe
	}
})
