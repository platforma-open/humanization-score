self := import("@platforma-sdk/workflow-tengo:tpl")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
math := import("math")

self.defineOutputs("outputHumanness", "exportPframe")


self.body(func(args) {

	blockId := args.blockId
	customBlockLabel := args.customBlockLabel

	baseMemGiB := 16
	if !is_undefined(args.mem) {
		baseMemGiB = args.mem
	}
	convMemGiB := string(int(math.max(16, baseMemGiB / 4))) + "GiB"

	params := args.params
	datasetSpec := params.datasetSpec
	isSingleCell := params.isSingleCell

	// One scoring unit per chain type. Bulk has a single unit (no chain split);
	// single-cell has up to two (A=Heavy, B=Light), each scored from its OWN
	// parquet so the "humanness_score" column name never collides across units.
	units := args.units

	clonotypeKeySpec := datasetSpec.axesSpec[1]

	// Fall back to the input dataset name when the user has not set a custom
	// label, keeping the provenance trace consistent with the block subtitle.
	blockLabel := customBlockLabel
	if blockLabel == "" {
		if datasetSpec.annotations && datasetSpec.annotations["pl7.app/label"] {
			blockLabel = datasetSpec.annotations["pl7.app/label"]
		} else {
			blockLabel = "Humanization Score"
		}
	}

	traceSteps := [{
		type: "milaboratories.humanization-score",
		importance: 30,
		label: blockLabel,
		id: blockId
	}]

	humannessTrace := pSpec.makeTrace(datasetSpec, traceSteps...)

	outputBuilder := pframes.pFrameBuilder()
	exportPframe := pframes.pFrameBuilder()

	// Build one humanness-score PColumn per unit and merge them into the same
	// output / export frames. Heavy (A) sorts first via a higher orderPriority.
	for unitId, unit in units {
		chain := unit.chain
		chainLabel := unit.chainLabel

		label := "Humanness Score"
		orderPriority := "100"
		domain := {}
		columnId := "humannessScore"

		if isSingleCell {
			label = "Humanness Score, " + chainLabel
			columnId = "humannessScore" + chain
			domain = {
				"pl7.app/vdj/scClonotypeChain": chain
			}
			// Heavy (A) sorts before Light (B).
			if chain != "A" {
				orderPriority = "99"
			}
		}

		// Tag blockId into the domain so exported columns are block-scoped.
		domain["pl7.app/blockId"] = blockId

		columnSpec := {
			column: "humanness_score",
			id: columnId,
			allowNA: true,
			spec: {
				name: "pl7.app/humannessScore",
				valueType: "Double",
				domain: domain,
				annotations: {
					"pl7.app/label": label,
					"pl7.app/description": "Promb / OASis (human-oas) humanness score in [0, 100]; fraction of 9-mers found in human antibody repertoires, rescaled. Higher = more human.",
					"pl7.app/table/visibility": "default",
					"pl7.app/table/orderPriority": orderPriority,
					"pl7.app/format": ".2~f",
					"pl7.app/isScore": "true",
					"pl7.app/score/rankingOrder": "decreasing",
					"pl7.app/score/method": "promb / OASis (human-oas)"
				}
			}
		}

		specs := {
			axes: [
				{
					column: "clonotypeKey",
					spec: clonotypeKeySpec
				}
			],
			columns: [columnSpec],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}

		importedColumns := xsv.importFile(
			unit.humannessTable,
			"parquet",
			specs,
			{splitDataAndSpec: true, cpu: 1, mem: convMemGiB}
		)

		for k, v in importedColumns {
			outputBuilder.add(k, v.spec, v.data)
			exportPframe.add(k, humannessTrace.inject(v.spec), v.data)
		}
	}

	outputHumanness := outputBuilder.build()
	exportPframe = exportPframe.build()

	return {
		outputHumanness: pframes.exportFrame(outputHumanness),
		exportPframe: exportPframe
	}
})
