// Peptide-mode humanness calculation. Mirrors clonotype-humanness.tpl.tengo
// but invokes the peptide_main.py entry point (no per-region / chain logic,
// no CDR-boundary annotations, no Cys-position checks).

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
math := import("math")

peptideLiabilitiesSw := assets.importSoftware("@platforma-open/milaboratories.humanization-score.humanness-calc-script:peptide")

self.defineOutputs("result")


self.body(func(args) {

	inputTable := args.table

	baseMemGiB := 16
	if !is_undefined(args.mem) {
		baseMemGiB = args.mem
	}

	// Run the peptide humanness scorer.
	cmd := exec.builder().
		software(peptideLiabilitiesSw).
		mem(string(int(math.max(8, baseMemGiB))) + "GiB").
		cpu(1).
		addFile("input.tsv", inputTable).
		arg("--input_tsv").arg("input.tsv").
		arg("--output_tsv").arg("result.tsv").
		saveFile("result.tsv")

	run := cmd.run()
	result := run.getFile("result.tsv")

	return {
		result: result
	}
})
